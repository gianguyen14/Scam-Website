{
  "manifest_version": 3,
  "name": "ScamGuard AI",
  "version": "0.1.0",
  "description": "Scam/Phishing Detector Extension",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Check Site Risk"
  },
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ]
}
